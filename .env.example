# Admin API base URL (the backend). Empty: the screens use the mock data in
# src/mocks/ (see src/api/*.js).
VITE_API_URL=
# Naver Maps Client ID (public; the admin's URL must be registered in the
# NCP console). Defaults to the member app's.
VITE_NAVER_MAP_CLIENT_ID=
# Seoulaim backend (Spring Boot) for the diary templates / stickers, image
# uploads and admin-key login (src/api/client.js). e.g. http://localhost:8080
# or https://43-203-45-240.sslip.io. Empty: login and the diary catalog
# don't work; uploads fall back to the mock.
VITE_API_BASE_URL=
# Base URL for the backend's S3 image keys: <this>/<imageKey>.
VITE_IMAGE_BASE_URL=
